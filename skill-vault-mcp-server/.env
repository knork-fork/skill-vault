APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-to-a-random-secret

BASE_LOCAL_URL=http://skill-vault-mcp-server-webserver

RESOURCES_DIR=/resources

SKILL_VAULT_UI_URL=http://localhost:20100

# Container-internal address for server-to-server calls to skill-vault-ui (e.g. token
# introspection), as opposed to SKILL_VAULT_UI_URL above which is host-facing and only
# ever handed to the browser/MCP client.
SKILL_VAULT_UI_INTERNAL_URL=http://skill-vault-ui-webserver

# Shared secret protecting skill-vault-ui's POST /oauth/introspect (must match its copy).
# Real value is generated by scripts/setup.sh into .env.local — never commit it here.
# OAUTH_INTROSPECTION_SHARED_SECRET=