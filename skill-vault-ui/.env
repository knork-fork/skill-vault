APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-to-a-random-secret

BASE_LOCAL_URL=http://skill-vault-ui-webserver

DATABASE_URL="postgresql://skill_vault:skill_vault@skill-vault-mcp-db:5432/skill_vault?serverVersion=16&charset=utf8"

RESOURCES_DIR=/resources

# Shared secret protecting POST /oauth/introspect (must match skill-vault-mcp-server's
# copy). Real value is generated by scripts/setup.sh into .env.local — never commit it here.
# OAUTH_INTROSPECTION_SHARED_SECRET=

# Invite-only signup. Empty (default) means /signup is open to anyone. Set by
# scripts/enable_invite_only.sh into .env.local — never commit a real value here.
# A random value requires ?invite=<value> on /signup; the literal value "disabled"
# turns /signup off entirely.
INVITE_SECRET=

SKILL_VAULT_MCP_URL=http://localhost:20101