parameters:
    level: 9
    checkUninitializedProperties: true
    checkBenevolentUnionTypes: true
    paths:
        - bin/
        - public/
        - src/
        - tests/
    ignoreErrors:
        - identifier: staticMethod.alreadyNarrowedType
          paths:
              - tests/Unit/ExampleTest.php
              - tests/Integration/ExampleTest.php
              - tests/Functional/ExampleTest.php
        # Doctrine sets these via reflection (id) or via the form's data_class binding
        # (username/password/firstName/lastName) rather than through the constructor.
        - identifier: property.uninitialized
          paths:
              - src/Entity/User.php
              - src/Entity/SkillGroup.php
        - identifier: property.unusedType
          paths:
              - src/Entity/User.php
              - src/Entity/SkillGroup.php
              - src/Entity/OAuthAuthCode.php
              - src/Entity/OAuthAccessToken.php
              - src/Entity/OAuthRefreshToken.php
        - identifier: return.type
          path: src/Entity/User.php