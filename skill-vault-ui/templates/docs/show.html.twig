{% extends 'base.html.twig' %}
{% import 'components/_shell.html.twig' as shell %}
{% import 'components/_topbar.html.twig' as topbar %}

{% block title %}{{ title }} · Skill Vault{% endblock %}

{% block stylesheets %}
{% include 'components/_shell_styles.html.twig' %}
{% include 'components/_topbar_styles.html.twig' %}
{% include 'components/_page_header_styles.html.twig' %}
<style>
    .content {
        padding: 0 40px 60px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .page-hero {
        gap: 12px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--text-muted);
        text-decoration: none;
    }

    .back-link:hover {
        color: var(--text);
    }

    .back-link svg {
        width: 15px;
        height: 15px;
    }

    .article-page {
        width: 100%;
    }

    .markdown-body {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: var(--card-shadow);
        padding: 32px 40px;
        color: var(--text-soft);
        line-height: 1.65;
    }

    .markdown-body h1,
    .markdown-body h2,
    .markdown-body h3,
    .markdown-body h4 {
        color: var(--text);
        font-weight: 800;
        letter-spacing: -0.01em;
        text-align: left;
    }

    .markdown-body h1 {
        font-size: 1.7rem;
        margin: 0 0 18px;
    }

    .markdown-body h2 {
        font-size: 1.3rem;
        margin: 32px 0 12px;
    }

    .markdown-body h3 {
        font-size: 1.1rem;
        margin: 24px 0 10px;
    }

    .markdown-body p {
        margin: 0 0 14px;
    }

    .markdown-body ul,
    .markdown-body ol {
        margin: 0 0 14px;
        padding-left: 22px;
    }

    .markdown-body li {
        margin-bottom: 6px;
    }

    .markdown-body a {
        color: var(--accent-deep);
    }

    .markdown-body code {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.86em;
        background: var(--surface-raised);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 1px 5px;
    }

    .markdown-body pre {
        position: relative;
        background: var(--surface-raised);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 16px 18px;
        overflow-x: auto;
        margin: 0 0 16px;
    }

    .markdown-body pre code {
        background: none;
        border: none;
        padding: 0;
        font-size: 0.86rem;
        line-height: 1.6;
    }

    .copy-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        width: auto;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--text-muted);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 4px 8px;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.15s ease;
    }

    .markdown-body pre:hover .copy-btn {
        opacity: 1;
    }

    .copy-btn:hover {
        color: var(--text);
        border-color: var(--accent);
    }

    .copy-btn svg {
        width: 13px;
        height: 13px;
    }

    .markdown-body blockquote {
        margin: 0 0 14px;
        padding: 4px 16px;
        border-left: 3px solid var(--border);
        color: var(--text-muted);
    }

    .markdown-body table {
        width: 100%;
        border-collapse: collapse;
        margin: 0 0 16px;
    }

    .markdown-body th,
    .markdown-body td {
        border: 1px solid var(--border);
        padding: 8px 12px;
        text-align: left;
        font-size: 0.9rem;
    }

    .markdown-body th {
        background: var(--surface-raised);
    }

    .markdown-body hr {
        border: none;
        border-top: 1px solid var(--border);
        margin: 24px 0;
    }
</style>
{% endblock %}

{% block body %}
<div class="app-shell">
    {{ shell.sidebar('docs') }}

    <div class="main">
        {{ topbar.render(user) }}

        <main class="content">
            <div class="page-hero">
                <div class="breadcrumb">
                    <a href="{{ path('app_home') }}">Home</a>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;color:var(--text-faint);"><polyline points="9 18 15 12 9 6"/></svg>
                    <a href="{{ path('app_docs') }}">Documentation</a>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;color:var(--text-faint);"><polyline points="9 18 15 12 9 6"/></svg>
                    <span>{{ title }}</span>
                </div>

                <div class="page-toolbar">
                    <a href="{{ path('app_docs') }}" class="back-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                        Back
                    </a>
                </div>
            </div>

            <div class="article-page">
                <div class="markdown-body">
                    {{ html|raw }}
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    var CHECK_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
    var COPY_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';

    document.querySelectorAll('.markdown-body pre').forEach(function (pre) {
        var button = document.createElement('button');
        button.type = 'button';
        button.className = 'copy-btn';
        button.innerHTML = COPY_ICON + '<span>Copy</span>';

        button.addEventListener('click', function () {
            var code = pre.querySelector('code');
            var text = code ? code.textContent : pre.textContent;

            navigator.clipboard.writeText(text || '').then(function () {
                button.innerHTML = CHECK_ICON + '<span>Copied</span>';
                setTimeout(function () {
                    button.innerHTML = COPY_ICON + '<span>Copy</span>';
                }, 1500);
            });
        });

        pre.appendChild(button);
    });
})();
</script>
{% endblock %}
