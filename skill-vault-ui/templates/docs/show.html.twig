{% extends 'base.html.twig' %}
{% import 'components/_shell.html.twig' as shell %}
{% import 'components/_topbar.html.twig' as topbar %}

{% block title %}{{ title }} · Skill Vault{% endblock %}

{% block stylesheets %}
{% include 'components/_shell_styles.html.twig' %}
{% include 'components/_topbar_styles.html.twig' %}
{% include 'components/_page_header_styles.html.twig' %}
<style>
    .content {
        padding: 0 40px 60px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .page-hero {
        gap: 12px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--text-muted);
        text-decoration: none;
    }

    .back-link:hover {
        color: var(--text);
    }

    .back-link svg {
        width: 15px;
        height: 15px;
    }

    .article-page {
        width: 100%;
    }

    .markdown-body {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: var(--card-shadow);
        padding: 32px 40px;
        color: var(--text-soft);
        line-height: 1.65;
    }

    .markdown-body h1,
    .markdown-body h2,
    .markdown-body h3,
    .markdown-body h4 {
        color: var(--text);
        font-weight: 800;
        letter-spacing: -0.01em;
        text-align: left;
    }

    .markdown-body h1 {
        font-size: 1.7rem;
        margin: 0 0 18px;
    }

    .markdown-body h2 {
        font-size: 1.3rem;
        margin: 32px 0 12px;
    }

    .markdown-body h3 {
        font-size: 1.1rem;
        margin: 24px 0 10px;
    }

    .markdown-body p {
        margin: 0 0 14px;
    }

    .markdown-body ul,
    .markdown-body ol {
        margin: 0 0 14px;
        padding-left: 22px;
    }

    .markdown-body li {
        margin-bottom: 6px;
    }

    .markdown-body a {
        color: var(--accent-deep);
    }

    .markdown-body code {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.86em;
        background: var(--surface-raised);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 1px 5px;
    }

    .markdown-body pre {
        background: var(--surface-raised);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 16px 18px;
        overflow-x: auto;
        margin: 0 0 16px;
    }

    .markdown-body pre code {
        background: none;
        border: none;
        padding: 0;
        font-size: 0.86rem;
        line-height: 1.6;
    }

    .markdown-body blockquote {
        margin: 0 0 14px;
        padding: 4px 16px;
        border-left: 3px solid var(--border);
        color: var(--text-muted);
    }

    .markdown-body table {
        width: 100%;
        border-collapse: collapse;
        margin: 0 0 16px;
    }

    .markdown-body th,
    .markdown-body td {
        border: 1px solid var(--border);
        padding: 8px 12px;
        text-align: left;
        font-size: 0.9rem;
    }

    .markdown-body th {
        background: var(--surface-raised);
    }

    .markdown-body hr {
        border: none;
        border-top: 1px solid var(--border);
        margin: 24px 0;
    }
</style>
{% endblock %}

{% block body %}
<div class="app-shell">
    {{ shell.sidebar('docs') }}

    <div class="main">
        {{ topbar.render(user) }}

        <main class="content">
            <div class="page-hero">
                <div class="breadcrumb">
                    <a href="{{ path('app_home') }}">Home</a>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;color:var(--text-faint);"><polyline points="9 18 15 12 9 6"/></svg>
                    <a href="{{ path('app_docs') }}">Documentation</a>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;color:var(--text-faint);"><polyline points="9 18 15 12 9 6"/></svg>
                    <span>{{ title }}</span>
                </div>

                <div class="page-toolbar">
                    <a href="{{ path('app_docs') }}" class="back-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                        Back
                    </a>
                </div>
            </div>

            <div class="article-page">
                <div class="markdown-body">
                    {{ html|raw }}
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
