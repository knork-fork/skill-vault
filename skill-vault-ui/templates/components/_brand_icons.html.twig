{#
    Third-party brand logos (actual brand colors, not currentColor-tintable
    like components/_avatar.html.twig). Usage:
        {% import 'components/_brand_icons.html.twig' as brand %}
        {{ brand.logo('trello') }}
#}
{% macro logo(key) %}
    {% if key == 'trello' %}
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="1.5" y="1.5" width="21" height="21" rx="4.5" style="fill:#0079bf;stroke:none;"/>
            <rect x="4.7" y="4.5" width="6" height="14" rx="1.4" style="fill:#fff;stroke:none;"/>
            <rect x="13.3" y="4.5" width="6" height="9" rx="1.4" style="fill:#fff;stroke:none;"/>
        </svg>
    {% elseif key == 'google_drive' %}
        <svg viewBox="0 0 87.3 78" aria-hidden="true">
            <path d="m6.6 66.85 3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3l13.75-23.8h-27.5c0 1.55.4 3.1 1.2 4.5z" style="fill:#0066da;stroke:none;"/>
            <path d="m43.65 25-13.75-23.8c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44a9.06 9.06 0 0 0 -1.2 4.5h27.5z" style="fill:#00ac47;stroke:none;"/>
            <path d="m73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5h-27.502l5.852 11.5z" style="fill:#ea4335;stroke:none;"/>
            <path d="m43.65 25 13.75-23.8c-1.35-.8-2.9-1.2-4.5-1.2h-18.5c-1.6 0-3.15.45-4.5 1.2z" style="fill:#00832d;stroke:none;"/>
            <path d="m59.8 53h-32.3l-13.75 23.8c1.35.8 2.9 1.2 4.5 1.2h50.8c1.6 0 3.15-.45 4.5-1.2z" style="fill:#2684fc;stroke:none;"/>
            <path d="m73.4 26.5-12.7-22c-.8-1.4-1.95-2.5-3.3-3.3l-13.75 23.8 16.15 28h27.45c0-1.55-.4-3.1-1.2-4.5z" style="fill:#ffba00;stroke:none;"/>
        </svg>
    {% endif %}
{% endmacro %}
