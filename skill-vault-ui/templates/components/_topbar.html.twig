{#
    Shared app topbar: global search, notifications, user menu.
    Usage: {% import 'components/_topbar.html.twig' as topbar %}
           {{ topbar.render(user) }}
    Include components/_topbar_styles.html.twig once in the page's stylesheets block.
#}
{% macro render(user) %}
    <header class="topbar">
        <div class="search-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <span>Search skills, groups, integrations...</span>
            <span class="kbd">⌘ K</span>
        </div>

        <div class="topbar-right">
            <a href="#" class="icon-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                <span class="dot"></span>
            </a>

            <div class="user-menu">
                <button type="button" class="user-menu-btn" id="userMenuBtn">
                    <span class="avatar">{{ (user.firstName|first ~ user.lastName|first)|upper }}</span>
                    <span class="name">{{ user.firstName }} {{ user.lastName }}</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="user-menu-panel">
                    <a href="{{ path('app_logout') }}">Log out</a>
                </div>
            </div>
        </div>
    </header>

    <script>
        (function () {
            var menuBtn = document.getElementById('userMenuBtn');
            menuBtn.addEventListener('click', function (event) {
                event.stopPropagation();
                menuBtn.closest('.user-menu').classList.toggle('open');
            });
            document.addEventListener('click', function (event) {
                if (event.target.closest('.user-menu-panel')) {
                    return;
                }
                menuBtn.closest('.user-menu').classList.remove('open');
            });
        })();
    </script>
{% endmacro %}
