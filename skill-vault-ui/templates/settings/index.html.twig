{% extends 'base.html.twig' %}
{% import 'components/_shell.html.twig' as shell %}
{% import 'components/_topbar.html.twig' as topbar %}

{% block title %}Settings · Skill Vault{% endblock %}

{% block stylesheets %}
{% include 'components/_avatar_styles.html.twig' %}
{% include 'components/_shell_styles.html.twig' %}
{% include 'components/_topbar_styles.html.twig' %}
{% include 'components/_page_header_styles.html.twig' %}
<style>
    .content {
        padding: 0 40px 40px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 16px;
    }

    .category-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: var(--card-shadow);
        padding: 22px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        color: inherit;
        text-decoration: none;
    }

    .category-card:hover {
        border-color: var(--accent);
    }

    .category-card .icon-badge {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: linear-gradient(140deg, var(--accent) 0%, var(--accent-deep) 100%);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .category-card .icon-badge svg {
        width: 22px;
        height: 22px;
    }

    .category-card h2 {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--text);
    }

    .category-card p {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.9rem;
        line-height: 1.45;
    }
</style>
{% endblock %}

{% block body %}
<div class="app-shell">
    {{ shell.sidebar('settings') }}

    <div class="main">
        {{ topbar.render(user) }}

        <main class="content">
            <div class="page-hero">
                <div class="breadcrumb">
                    <a href="{{ path('app_home') }}">Home</a>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;color:var(--text-faint);"><polyline points="9 18 15 12 9 6"/></svg>
                    <span>Settings</span>
                </div>

                <div class="page-header">
                    <div>
                        <h1>Settings</h1>
                        <p>Manage your account and Skill Vault preferences.</p>
                    </div>
                </div>
            </div>

            <div class="category-grid">
                <a href="{{ path('app_settings_user') }}" class="category-card">
                    <span class="icon-badge">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </span>
                    <h2>User Settings</h2>
                    <p>Manage your account, including your password.</p>
                </a>
                <a href="{{ path('app_settings_env_vars') }}" class="category-card">
                    <span class="icon-badge">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
                    </span>
                    <h2>Environment Variables</h2>
                    <p>Define placeholders and values available to your skills.</p>
                </a>
            </div>
        </main>
    </div>
</div>
{% endblock %}
