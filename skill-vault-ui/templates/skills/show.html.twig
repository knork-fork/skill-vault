{% extends 'base.html.twig' %}
{% import 'components/_avatar.html.twig' as avatar %}
{% import 'components/_shell.html.twig' as shell %}
{% import 'components/_topbar.html.twig' as topbar %}

{% block title %}{{ skill.name }} · Skill Vault{% endblock %}

{% block stylesheets %}
{% include 'components/_avatar_styles.html.twig' %}
{% include 'components/_shell_styles.html.twig' %}
{% include 'components/_topbar_styles.html.twig' %}
{% include 'components/_page_header_styles.html.twig' %}
<style>
    .content {
        padding: 0 40px 60px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* Tighter than the shared default: this page only wraps a breadcrumb
       and a slim back-link/actions row, not a full title+toolbar block. */
    .page-hero {
        gap: 12px;
    }

    .skill-page {
        width: 100%;
    }

    .page-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--text-muted);
        text-decoration: none;
    }

    .back-link:hover {
        color: var(--text);
    }

    .back-link svg {
        width: 15px;
        height: 15px;
    }

    .toolbar-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-outline {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        width: auto;
        padding: 9px 16px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--text);
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
    }

    .btn-outline:hover {
        border-color: var(--border-strong);
    }

    .btn-outline svg {
        width: 15px;
        height: 15px;
    }

    .icon-btn-outline {
        width: 38px;
        height: 38px;
        padding: 0;
        justify-content: center;
    }

    .row-menu {
        position: relative;
    }

    .row-menu-panel {
        display: none;
        position: absolute;
        right: 0;
        top: 44px;
        z-index: 5;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(20, 30, 60, 0.14);
        min-width: 150px;
        padding: 6px;
    }

    .row-menu.open .row-menu-panel {
        display: block;
    }

    .row-menu-panel button {
        width: 100%;
        text-align: left;
        background: none;
        border: none;
        padding: 8px 10px;
        border-radius: 7px;
        font-size: 0.86rem;
        font-weight: 600;
        color: var(--text-soft);
        cursor: pointer;
    }

    .row-menu-panel button:hover {
        background: var(--surface-raised);
        color: var(--text);
    }

    .row-menu-panel button.danger {
        color: var(--danger);
    }

    .row-menu-panel select.menu-select {
        width: 100%;
        background: none;
        border: none;
        padding: 8px 10px;
        border-radius: 7px;
        font-size: 0.86rem;
        font-weight: 600;
        color: var(--text-soft);
        cursor: pointer;
        appearance: none;
    }

    .row-menu-panel select.menu-select:hover {
        background: var(--surface-raised);
        color: var(--text);
    }

    .skill-header {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 20px;
    }

    .skill-header h1 {
        margin: 0 0 4px;
        font-size: 1.5rem;
        font-weight: 800;
        letter-spacing: -0.01em;
        text-align: left;
    }

    .skill-header p {
        margin: 0;
        color: var(--text-muted);
        line-height: 1.5;
        max-width: 520px;
    }

    .group-field {
        margin-bottom: 22px;
    }

    .group-field .picker-label {
        display: block;
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 8px;
    }

    .group-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--text-soft);
        background: var(--surface-raised);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 5px 12px;
    }

    .group-badge svg {
        width: 15px;
        height: 15px;
    }

    .tabs {
        display: flex;
        gap: 22px;
        border-bottom: 1px solid var(--border);
        margin-bottom: 18px;
    }

    .tab {
        width: auto;
        border: none;
        border-radius: 0;
        background: none;
        padding: 0 0 12px;
        font-size: 0.92rem;
        font-weight: 700;
        color: var(--text-muted);
        cursor: pointer;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
    }

    .tab.active {
        color: var(--text);
        border-bottom-color: var(--accent);
    }

    .tab-panel {
        display: none;
    }

    .tab-panel.active {
        display: block;
    }

    .content-box {
        background: var(--surface-raised);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 20px 22px;
    }

    .content-box pre {
        margin: 0;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.88rem;
        line-height: 1.6;
        color: var(--text);
        white-space: pre-wrap;
        word-break: break-word;
    }

    .details-grid {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .details-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        background: var(--surface-raised);
        border: 1px solid var(--border);
        border-radius: 10px;
    }

    .details-row .label {
        font-size: 0.85rem;
        color: var(--text-muted);
        font-weight: 600;
    }

    .details-row .value {
        font-size: 0.9rem;
        color: var(--text);
        font-weight: 700;
    }
</style>
{% endblock %}

{% block body %}
<div class="app-shell">
    {{ shell.sidebar('skills') }}

    <div class="main">
        {{ topbar.render(user) }}

        <main class="content">
            <div class="page-hero">
                <div class="breadcrumb">
                    <a href="{{ path('app_home') }}">Home</a>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;color:var(--text-faint);"><polyline points="9 18 15 12 9 6"/></svg>
                    <a href="{{ path('app_skills') }}">Skills</a>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;color:var(--text-faint);"><polyline points="9 18 15 12 9 6"/></svg>
                    <span>{{ skill.name }}</span>
                </div>

                <div class="page-toolbar">
                    <a href="{{ path('app_skills') }}" class="back-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                        Back
                    </a>

                    <div class="toolbar-actions">
                        <a href="{{ path('app_skill_edit', {slug: skill.slug}) }}" class="btn-outline">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            Edit
                        </a>
                        <div class="row-menu">
                            <button type="button" class="btn-outline icon-btn-outline" id="skillMenuBtn" aria-label="More options">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
                            </button>
                            <div class="row-menu-panel">
                                <button type="button">Duplicate</button>
                                <form method="post" action="{{ path('app_skill_move_to_group') }}" style="display:contents;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('move_skill') }}">
                                    <input type="hidden" name="slug" value="{{ skill.slug }}">
                                    <input type="hidden" name="redirect" value="skill">
                                    <select name="group" class="menu-select" onchange="this.form.submit()">
                                        <option value="" {{ skill.group ? '' : 'selected' }}>Move to group…</option>
                                        {% for groupName in groupNames %}
                                            <option value="{{ groupName }}" {{ skill.group == groupName ? 'selected' : '' }}>{{ groupName }}</option>
                                        {% endfor %}
                                    </select>
                                </form>
                                <form method="post" action="{{ path('app_skill_delete', {slug: skill.slug}) }}" onsubmit="return confirm('Delete this skill? This cannot be undone.');" style="display:contents;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_skill') }}">
                                    <input type="hidden" name="redirect" value="skills">
                                    <button type="submit" class="danger">Delete skill</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="skill-page">

                <div class="skill-header">
                    {{ avatar.render(skill.icon, skill.color, 'lg') }}
                    <div>
                        <h1>{{ skill.name }}</h1>
                        <p>{{ skill.description }}</p>
                    </div>
                </div>

                <div class="group-field">
                    <span class="picker-label">Group</span>
                    {% if skill.group %}
                        <span class="group-badge">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            {{ skill.group }}
                        </span>
                    {% else %}
                        <span class="group-badge">Ungrouped</span>
                    {% endif %}
                </div>

                <div class="tabs">
                    <button type="button" class="tab active" data-tab="content">Content</button>
                    <button type="button" class="tab" data-tab="details">Details</button>
                </div>

                <div class="tab-panel active" id="contentTab">
                    <div class="content-box">
                        <pre>{{ skill.content }}</pre>
                    </div>
                </div>

                <div class="tab-panel" id="detailsTab">
                    <div class="details-grid">
                        <div class="details-row">
                            <span class="label">Group</span>
                            <span class="value">{{ skill.group ?: 'Ungrouped' }}</span>
                        </div>
                        <div class="details-row">
                            <span class="label">Last updated</span>
                            <span class="value">{{ skill.updated }}</span>
                        </div>
                        <div class="details-row">
                            <span class="label">Version</span>
                            <span class="value">v1.0.0</span>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    var tabs = document.querySelectorAll('.tab');
    var panels = {
        content: document.getElementById('contentTab'),
        details: document.getElementById('detailsTab')
    };

    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
            tabs.forEach(function (t) {
                t.classList.remove('active');
            });
            tab.classList.add('active');
            Object.keys(panels).forEach(function (key) {
                panels[key].classList.toggle('active', key === tab.dataset.tab);
            });
        });
    });

    var menuBtn = document.getElementById('skillMenuBtn');
    menuBtn.addEventListener('click', function (event) {
        event.stopPropagation();
        menuBtn.closest('.row-menu').classList.toggle('open');
    });
    document.addEventListener('click', function (event) {
        if (event.target.closest('.row-menu-panel')) {
            return;
        }
        menuBtn.closest('.row-menu').classList.remove('open');
    });
})();
</script>
{% endblock %}
