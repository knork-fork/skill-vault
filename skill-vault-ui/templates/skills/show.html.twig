{% extends 'base.html.twig' %}
{% import 'components/_avatar.html.twig' as avatar %}
{% import 'components/_shell.html.twig' as shell %}
{% import 'components/_topbar.html.twig' as topbar %}

{% block title %}{{ skill.name }} · Skill Vault{% endblock %}

{% block stylesheets %}
{% include 'components/_avatar_styles.html.twig' %}
{% include 'components/_shell_styles.html.twig' %}
{% include 'components/_topbar_styles.html.twig' %}
{% include 'components/_page_header_styles.html.twig' %}
<style>
    .content {
        padding: 0 40px 60px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* Tighter than the shared default: this page only wraps a breadcrumb
       and a slim back-link/actions row, not a full title+toolbar block. */
    .page-hero {
        gap: 12px;
    }

    .skill-page {
        width: 100%;
    }

    .page-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--text-muted);
        text-decoration: none;
    }

    .back-link:hover {
        color: var(--text);
    }

    .back-link svg {
        width: 15px;
        height: 15px;
    }

    .toolbar-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-outline {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        width: auto;
        padding: 9px 16px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--text);
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
    }

    .btn-outline:hover {
        border-color: var(--border-strong);
    }

    .btn-outline svg {
        width: 15px;
        height: 15px;
    }

    .icon-btn-outline {
        width: 38px;
        height: 38px;
        padding: 0;
        justify-content: center;
    }

    .row-menu {
        position: relative;
    }

    .row-menu-panel {
        display: none;
        position: absolute;
        right: 0;
        top: 44px;
        z-index: 5;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(20, 30, 60, 0.14);
        min-width: 150px;
        padding: 6px;
    }

    .row-menu.open .row-menu-panel {
        display: block;
    }

    .row-menu-panel button {
        width: 100%;
        text-align: left;
        background: none;
        border: none;
        padding: 8px 10px;
        border-radius: 7px;
        font-size: 0.86rem;
        font-weight: 600;
        color: var(--text-soft);
        cursor: pointer;
    }

    .row-menu-panel button:hover {
        background: var(--surface-raised);
        color: var(--text);
    }

    .row-menu-panel button.danger {
        color: var(--danger);
    }

    .row-menu-panel select.menu-select {
        width: 100%;
        background: none;
        border: none;
        padding: 8px 10px;
        border-radius: 7px;
        font-size: 0.86rem;
        font-weight: 600;
        color: var(--text-soft);
        cursor: pointer;
        appearance: none;
    }

    .row-menu-panel select.menu-select:hover {
        background: var(--surface-raised);
        color: var(--text);
    }

    .skill-header {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 20px;
    }

    .skill-header h1 {
        margin: 0 0 4px;
        font-size: 1.5rem;
        font-weight: 800;
        letter-spacing: -0.01em;
        text-align: left;
    }

    .skill-header p {
        margin: 0;
        color: var(--text-muted);
        line-height: 1.5;
        max-width: 520px;
    }

    .group-field {
        margin-bottom: 22px;
    }

    .group-field .picker-label {
        display: block;
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 8px;
    }

    .group-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--text-soft);
        background: var(--surface-raised);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 5px 12px;
    }

    .group-badge svg {
        width: 15px;
        height: 15px;
    }

    .tabs {
        display: flex;
        gap: 22px;
        border-bottom: 1px solid var(--border);
        margin-bottom: 18px;
    }

    .tab {
        width: auto;
        border: none;
        border-radius: 0;
        background: none;
        padding: 0 0 12px;
        font-size: 0.92rem;
        font-weight: 700;
        color: var(--text-muted);
        cursor: pointer;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
    }

    .tab.active {
        color: var(--text);
        border-bottom-color: var(--accent);
    }

    .tab-panel {
        display: none;
    }

    .tab-panel.active {
        display: block;
    }

    .content-box {
        background: var(--surface-raised);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 20px 22px;
    }

    .content-box pre {
        margin: 0;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.88rem;
        line-height: 1.6;
        color: var(--text);
        white-space: pre-wrap;
        word-break: break-word;
    }

    .details-grid {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .details-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        background: var(--surface-raised);
        border: 1px solid var(--border);
        border-radius: 10px;
    }

    .details-row .label {
        font-size: 0.85rem;
        color: var(--text-muted);
        font-weight: 600;
    }

    .details-row .value {
        font-size: 0.9rem;
        color: var(--text);
        font-weight: 700;
    }

    .history-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-bottom: 20px;
    }

    .history-stat {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        background: var(--surface-raised);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 18px 20px;
    }

    .history-stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .history-stat-icon svg {
        width: 24px;
        height: 24px;
    }

    .history-stat-value {
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--text);
        line-height: 1.25;
    }

    .history-stat-label {
        font-size: 0.88rem;
        color: var(--text-soft);
        font-weight: 600;
        margin-top: 2px;
    }

    .history-stat-caption {
        font-size: 0.78rem;
        color: var(--text-faint);
        margin-top: 6px;
    }

    .history-empty {
        margin: 0;
        padding: 40px 20px;
        text-align: center;
        color: var(--text-muted);
        font-size: 0.9rem;
        background: var(--surface-raised);
        border: 1px solid var(--border);
        border-radius: 12px;
    }

    .history-list {
        position: relative;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
    }

    .history-row {
        position: relative;
        display: flex;
        align-items: stretch;
        gap: 12px;
        padding: 0 20px;
    }

    .history-row:not(:last-child) {
        border-bottom: 1px solid var(--border);
    }

    .history-row.current {
        background: rgba(43, 82, 224, 0.06);
    }

    .history-row-marker {
        position: relative;
        flex-shrink: 0;
        width: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* A line through the marker's full height, trimmed to start/end at this row's
       dot (which sits at 50%, same as the line) instead of at the row edge - so it
       always touches every dot exactly, regardless of row height. */
    .history-row-marker::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 2px;
        background: var(--border);
        transform: translateX(-50%);
    }

    .history-row:first-child .history-row-marker::before {
        top: 50%;
    }

    .history-row:last-child .history-row-marker::before {
        bottom: 50%;
    }

    .history-dot {
        position: relative;
        z-index: 1;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--border-strong);
        border: 2px solid var(--surface);
    }

    .history-row.current .history-dot {
        background: var(--accent);
        border-color: rgba(43, 82, 224, 0.06);
    }

    .history-row-body {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 16px 0;
    }

    .history-row-top {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
    }

    .history-version {
        font-size: 0.9rem;
        font-weight: 800;
        color: var(--text);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    .history-current-pill {
        display: inline-flex;
        align-items: center;
        font-size: 0.75rem;
        font-weight: 700;
        color: #1a7f4b;
        background: rgba(26, 127, 75, 0.12);
        border-radius: 999px;
        padding: 2px 10px;
    }

    .history-row-meta {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text-muted);
        font-size: 0.85rem;
    }

    .history-avatar {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: linear-gradient(140deg, var(--accent) 0%, var(--accent-deep) 100%);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.68rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .history-author {
        color: var(--text-soft);
        font-weight: 600;
    }

    .history-row-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .history-action {
        padding: 8px 14px;
        font-size: 0.82rem;
    }

    .history-action:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
</style>
{% endblock %}

{% block body %}
<div class="app-shell">
    {{ shell.sidebar('skills') }}

    <div class="main">
        {{ topbar.render(user) }}

        <main class="content">
            <div class="page-hero">
                <div class="breadcrumb">
                    <a href="{{ path('app_home') }}">Home</a>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;color:var(--text-faint);"><polyline points="9 18 15 12 9 6"/></svg>
                    <a href="{{ path('app_skills') }}">Skills</a>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;color:var(--text-faint);"><polyline points="9 18 15 12 9 6"/></svg>
                    <span>{{ skill.name }}</span>
                </div>

                <div class="page-toolbar">
                    <a href="{{ path('app_skills') }}" class="back-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                        Back
                    </a>

                    <div class="toolbar-actions">
                        <a href="{{ path('app_skill_edit', {slug: skill.slug}) }}" class="btn-outline">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            Edit
                        </a>
                        <div class="row-menu">
                            <button type="button" class="btn-outline icon-btn-outline" id="skillMenuBtn" aria-label="More options">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
                            </button>
                            <div class="row-menu-panel">
                                <button type="button">Duplicate</button>
                                <form method="post" action="{{ path('app_skill_move_to_group') }}" style="display:contents;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('move_skill') }}">
                                    <input type="hidden" name="slug" value="{{ skill.slug }}">
                                    <input type="hidden" name="redirect" value="skill">
                                    <select name="group" class="menu-select" onchange="this.form.submit()">
                                        <option value="" {{ skill.group ? '' : 'selected' }}>Move to group…</option>
                                        {% for groupName in groupNames %}
                                            <option value="{{ groupName }}" {{ skill.group == groupName ? 'selected' : '' }}>{{ groupName }}</option>
                                        {% endfor %}
                                    </select>
                                </form>
                                <form method="post" action="{{ path('app_skill_delete', {slug: skill.slug}) }}" onsubmit="return confirm('Delete this skill? This cannot be undone.');" style="display:contents;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_skill') }}">
                                    <input type="hidden" name="redirect" value="skills">
                                    <button type="submit" class="danger">Delete skill</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="skill-page">

                <div class="skill-header">
                    {{ avatar.render(skill.icon, skill.color, 'lg') }}
                    <div>
                        <h1>{{ skill.name }}</h1>
                        <p>{{ skill.description }}</p>
                    </div>
                </div>

                <div class="group-field">
                    <span class="picker-label">Group</span>
                    {% if skill.group %}
                        <span class="group-badge">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            {{ skill.group }}
                        </span>
                    {% else %}
                        <span class="group-badge">Ungrouped</span>
                    {% endif %}
                </div>

                <div class="tabs">
                    <button type="button" class="tab active" data-tab="content">Content</button>
                    <button type="button" class="tab" data-tab="details">Details</button>
                    <button type="button" class="tab" data-tab="history">History</button>
                </div>

                <div class="tab-panel active" id="contentTab">
                    <div class="content-box">
                        <pre>{{ skill.content }}</pre>
                    </div>
                </div>

                <div class="tab-panel" id="detailsTab">
                    <div class="details-grid">
                        <div class="details-row">
                            <span class="label">Group</span>
                            <span class="value">{{ skill.group ?: 'Ungrouped' }}</span>
                        </div>
                        <div class="details-row">
                            <span class="label">Last updated</span>
                            <span class="value">{{ skill.updated }}</span>
                        </div>
                        <div class="details-row">
                            <span class="label">Version</span>
                            <span class="value">v1.0.0</span>
                        </div>
                    </div>
                </div>

                <div class="tab-panel" id="historyTab">
                    <div class="history-summary">
                        <div class="history-stat">
                            <span class="history-stat-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                            </span>
                            <div>
                                <div class="history-stat-value" data-history-total-versions>—</div>
                                <div class="history-stat-label">Total versions</div>
                                <div class="history-stat-caption">Across all saved edits</div>
                            </div>
                        </div>
                        <div class="history-stat">
                            <span class="history-stat-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            </span>
                            <div>
                                <div class="history-stat-value" data-history-last-edited-by>—</div>
                                <div class="history-stat-label">Last edited by</div>
                                <div class="history-stat-caption" data-history-last-edited-at></div>
                            </div>
                        </div>
                        <div class="history-stat">
                            <span class="history-stat-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3.24H4a1 1 0 0 0-1 1v5.59a2 2 0 0 0 .59 1.41l9.58 9.58a2 2 0 0 0 2.82 0l4.6-4.6a2 2 0 0 0 0-2.82z"/><circle cx="7.5" cy="7.5" r="1"/></svg>
                            </span>
                            <div>
                                <div class="history-stat-value" data-history-current-version>—</div>
                                <div class="history-stat-label">Current version</div>
                                <div class="history-stat-caption" data-history-current-date></div>
                            </div>
                        </div>
                    </div>

                    <div class="history-list" data-history-list>
                        <p class="history-empty">Loading history…</p>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    var tabs = document.querySelectorAll('.tab');
    var panels = {
        content: document.getElementById('contentTab'),
        details: document.getElementById('detailsTab'),
        history: document.getElementById('historyTab')
    };

    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
            tabs.forEach(function (t) {
                t.classList.remove('active');
            });
            tab.classList.add('active');
            Object.keys(panels).forEach(function (key) {
                panels[key].classList.toggle('active', key === tab.dataset.tab);
            });
            if (tab.dataset.tab === 'history') {
                loadHistory();
            }
        });
    });

    var historyLoaded = false;

    function loadHistory() {
        if (historyLoaded) {
            return;
        }
        historyLoaded = true;

        fetch('{{ path('app_skill_history', {slug: skill.slug}) }}', {
            headers: { 'Accept': 'application/json' }
        })
            .then(function (response) {
                return response.json();
            })
            .then(renderHistory)
            .catch(function () {
                historyLoaded = false;
                renderHistory(null);
            });
    }

    function renderHistory(history) {
        var list = document.querySelector('[data-history-list]');
        list.textContent = '';

        if (!history) {
            document.querySelector('[data-history-total-versions]').textContent = '—';
            document.querySelector('[data-history-last-edited-by]').textContent = '—';
            document.querySelector('[data-history-last-edited-at]').textContent = '';
            document.querySelector('[data-history-current-version]').textContent = '—';
            document.querySelector('[data-history-current-date]').textContent = '';

            var empty = document.createElement('p');
            empty.className = 'history-empty';
            empty.textContent = 'No git repo setup';
            list.appendChild(empty);
            return;
        }

        var current = history.versions[0];

        document.querySelector('[data-history-total-versions]').textContent = history.totalVersions;
        document.querySelector('[data-history-last-edited-by]').textContent = history.lastEditedBy;
        document.querySelector('[data-history-last-edited-at]').textContent = current.relative;
        document.querySelector('[data-history-current-version]').textContent = 'Version ' + history.currentVersion;
        document.querySelector('[data-history-current-date]').textContent = current.date;

        history.versions.forEach(function (version) {
            list.appendChild(buildHistoryRow(version));
        });
    }

    function buildHistoryRow(version) {
        var row = document.createElement('div');
        row.className = 'history-row' + (version.current ? ' current' : '');

        var marker = document.createElement('div');
        marker.className = 'history-row-marker';
        var dot = document.createElement('span');
        dot.className = 'history-dot';
        marker.appendChild(dot);
        row.appendChild(marker);

        var card = document.createElement('div');
        card.className = 'history-row-body';

        var main = document.createElement('div');

        var top = document.createElement('div');
        top.className = 'history-row-top';
        var versionLabel = document.createElement('span');
        versionLabel.className = 'history-version';
        versionLabel.textContent = 'Version ' + version.version;
        top.appendChild(versionLabel);
        if (version.current) {
            var pill = document.createElement('span');
            pill.className = 'history-current-pill';
            pill.textContent = 'Current version';
            top.appendChild(pill);
        }
        main.appendChild(top);

        var meta = document.createElement('div');
        meta.className = 'history-row-meta';
        var avatar = document.createElement('span');
        avatar.className = 'history-avatar';
        avatar.textContent = version.authorInitials;
        var author = document.createElement('span');
        author.className = 'history-author';
        author.textContent = version.author;
        var time = document.createElement('span');
        time.textContent = version.relative + ' · ' + version.date;
        meta.appendChild(avatar);
        meta.appendChild(author);
        meta.appendChild(time);
        main.appendChild(meta);

        card.appendChild(main);

        var actions = document.createElement('div');
        actions.className = 'history-row-actions';

        var viewDiff = document.createElement('button');
        viewDiff.type = 'button';
        viewDiff.className = 'btn-outline history-action';
        viewDiff.textContent = 'View diff';
        viewDiff.disabled = true;
        actions.appendChild(viewDiff);

        var compare = document.createElement('button');
        compare.type = 'button';
        compare.className = 'btn-outline history-action';
        compare.textContent = 'Compare';
        compare.disabled = true;
        actions.appendChild(compare);

        var viewFile = document.createElement('button');
        viewFile.type = 'button';
        viewFile.className = 'btn-outline icon-btn-outline history-action';
        viewFile.setAttribute('aria-label', 'View file at this version');
        viewFile.title = 'View file at this version';
        viewFile.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
        viewFile.disabled = true;
        actions.appendChild(viewFile);

        card.appendChild(actions);
        row.appendChild(card);

        return row;
    }

    var menuBtn = document.getElementById('skillMenuBtn');
    menuBtn.addEventListener('click', function (event) {
        event.stopPropagation();
        menuBtn.closest('.row-menu').classList.toggle('open');
    });
    document.addEventListener('click', function (event) {
        if (event.target.closest('.row-menu-panel')) {
            return;
        }
        menuBtn.closest('.row-menu').classList.remove('open');
    });
})();
</script>
{% endblock %}
