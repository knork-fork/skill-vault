{% extends 'base.html.twig' %}
{% import 'components/_avatar.html.twig' as avatar %}
{% import 'components/_shell.html.twig' as shell %}
{% import 'components/_topbar.html.twig' as topbar %}

{% block title %}Skills · Skill Vault{% endblock %}

{% block stylesheets %}
{% include 'components/_avatar_styles.html.twig' %}
{% include 'components/_shell_styles.html.twig' %}
{% include 'components/_topbar_styles.html.twig' %}
{% include 'components/_page_header_styles.html.twig' %}
<style>
    .content {
        padding: 0 40px 40px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* This page has a single filter select, so push it to the toolbar's end. */
    #groupFilter {
        margin-left: auto;
    }

    .panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: var(--card-shadow);
        overflow: hidden;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead th {
        text-align: left;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--text-faint);
        font-weight: 700;
        padding: 12px 20px;
        border-bottom: 1px solid var(--border);
        background: var(--surface-raised);
    }

    thead th.sortable {
        cursor: pointer;
        user-select: none;
    }

    thead th.sortable .sort-arrow {
        display: inline-block;
        margin-left: 4px;
        width: 10px;
        height: 10px;
        vertical-align: middle;
    }

    tbody tr {
        border-bottom: 1px solid var(--border);
        cursor: pointer;
    }

    tbody tr:last-child {
        border-bottom: none;
    }

    tbody tr:hover {
        background: var(--surface-raised);
    }

    tbody td {
        padding: 13px 20px;
        vertical-align: middle;
        font-size: 0.92rem;
        color: var(--text-soft);
    }

    .skill-name-cell {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 700;
        color: var(--text);
        white-space: nowrap;
    }

    .col-description {
        max-width: 320px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .group-pill {
        display: inline-flex;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--text-soft);
        background: var(--surface-raised);
        border-radius: 999px;
        padding: 3px 10px;
    }

    .group-pill.none {
        color: var(--text-faint);
    }

    .col-updated {
        color: var(--text-faint);
        white-space: nowrap;
    }

    .row-menu {
        position: relative;
        text-align: right;
    }

    .row-menu-btn {
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        color: var(--text-faint);
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
    }

    .row-menu-btn:hover {
        background: var(--surface);
        color: var(--text-soft);
    }

    .row-menu-btn svg {
        width: 17px;
        height: 17px;
    }

    .row-menu-panel {
        display: none;
        position: absolute;
        right: 20px;
        top: 34px;
        z-index: 5;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(20, 30, 60, 0.14);
        min-width: 140px;
        padding: 6px;
        text-align: left;
    }

    .row-menu.open .row-menu-panel {
        display: block;
    }

    .row-menu-panel button {
        width: 100%;
        text-align: left;
        background: none;
        border: none;
        padding: 8px 10px;
        border-radius: 7px;
        font-size: 0.86rem;
        font-weight: 600;
        color: var(--text-soft);
        cursor: pointer;
    }

    .row-menu-panel button:hover {
        background: var(--surface-raised);
        color: var(--text);
    }

    .row-menu-panel button.danger {
        color: var(--danger);
    }

    .empty-state {
        padding: 30px 10px;
        text-align: center;
        color: var(--text-muted);
        font-size: 0.9rem;
    }
</style>
{% endblock %}

{% block body %}
<div class="app-shell">
    {{ shell.sidebar('skills') }}

    <div class="main">
        {{ topbar.render(user) }}

        <main class="content">
            <div class="page-hero">
                <div class="breadcrumb">
                    <a href="{{ path('app_home') }}">Home</a>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;color:var(--text-faint);"><polyline points="9 18 15 12 9 6"/></svg>
                    <span>Skills</span>
                </div>

                <div class="page-header">
                    <div>
                        <h1>Skills</h1>
                        <p>Manage your skills. These are instructions and knowledge that Claude can use.</p>
                    </div>
                    <a href="{{ path('app_skills_new') }}" class="btn btn-primary btn-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        Create Skill
                    </a>
                </div>

                <div class="toolbar">
                    <label class="search-input">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        <input type="text" id="skillSearch" placeholder="Search skills...">
                    </label>

                    <select class="filter-select" id="groupFilter">
                        <option value="all">All groups</option>
                        {% for groupName in groupNames %}
                            <option value="{{ groupName }}">{{ groupName }}</option>
                        {% endfor %}
                        <option value="__none__">Ungrouped</option>
                    </select>
                </div>
            </div>

            <div class="panel">
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Group</th>
                            <th class="sortable" id="sortByUpdated">
                                Updated
                                <svg class="sort-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                            </th>
                        </tr>
                    </thead>
                    <tbody id="skillTableBody">
                        {% for skill in skills %}
                            <tr data-name="{{ skill.name|lower }}" data-group="{{ skill.group ?: '__none__' }}" data-days="{{ skill.daysAgo }}" onclick="window.location='{{ path('app_skill', {slug: skill.slug}) }}'">
                                <td>
                                    <span class="skill-name-cell">
                                        {{ avatar.render(skill.icon, skill.color, 'sm') }}
                                        {{ skill.name }}
                                    </span>
                                </td>
                                <td class="col-description">{{ skill.description }}</td>
                                <td>
                                    {% if skill.group %}
                                        <span class="group-pill">{{ skill.group }}</span>
                                    {% else %}
                                        <span class="group-pill none">Ungrouped</span>
                                    {% endif %}
                                </td>
                                <td class="col-updated">{{ skill.updated }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="empty-state">No skills available, please add new ones.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                <div class="empty-state" id="skillEmptyState" style="display:none;">No skills match your filters.</div>
            </div>
        </main>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    var tableBody = document.getElementById('skillTableBody');
    var searchInput = document.getElementById('skillSearch');
    var groupFilter = document.getElementById('groupFilter');
    var emptyState = document.getElementById('skillEmptyState');
    var sortHeader = document.getElementById('sortByUpdated');
    var sortAscending = false;

    function applyFilters() {
        var query = searchInput.value.trim().toLowerCase();
        var group = groupFilter.value;
        var visibleCount = 0;

        Array.prototype.forEach.call(tableBody.children, function (row) {
            var matchesQuery = !query || row.dataset.name.indexOf(query) !== -1;
            var matchesGroup = group === 'all' || row.dataset.group === group;
            var visible = matchesQuery && matchesGroup;
            row.style.display = visible ? '' : 'none';
            if (visible) {
                visibleCount++;
            }
        });

        emptyState.style.display = visibleCount === 0 ? '' : 'none';
    }

    searchInput.addEventListener('input', applyFilters);
    groupFilter.addEventListener('change', applyFilters);

    sortHeader.addEventListener('click', function () {
        sortAscending = !sortAscending;
        var rows = Array.prototype.slice.call(tableBody.children);
        rows.sort(function (a, b) {
            var diff = parseInt(a.dataset.days, 10) - parseInt(b.dataset.days, 10);
            return sortAscending ? diff : -diff;
        });
        rows.forEach(function (row) {
            tableBody.appendChild(row);
        });
    });

    document.addEventListener('click', function (event) {
        var menuBtn = event.target.closest('.row-menu-btn');
        var panel = event.target.closest('.row-menu-panel');
        document.querySelectorAll('.row-menu.open').forEach(function (menu) {
            var keepOpen = (menuBtn && menu === menuBtn.closest('.row-menu')) || (panel && menu.contains(panel));
            if (!keepOpen) {
                menu.classList.remove('open');
            }
        });
        if (menuBtn) {
            event.stopPropagation();
            menuBtn.closest('.row-menu').classList.toggle('open');
        }
    });
})();
</script>
{% endblock %}
