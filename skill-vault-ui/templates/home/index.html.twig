{% extends 'base.html.twig' %}

{% block title %}Skill Vault{% endblock %}

{% block stylesheets %}
<style>
    .app-shell {
        display: flex;
        min-height: 100vh;
        align-items: stretch;
    }

    /* Sidebar */
    .sidebar {
        width: 292px;
        flex-shrink: 0;
        background: var(--surface);
        border-right: 1px solid var(--border);
        padding: 22px 16px;
        display: flex;
        flex-direction: column;
        gap: 26px;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 4px 8px;
        font-size: 1.42rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--text);
    }

    .brand .icon-badge {
        width: 46px;
        height: 46px;
        border-radius: 13px;
        background: linear-gradient(140deg, var(--accent) 0%, var(--accent-deep) 100%);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 2px 6px rgba(43, 82, 224, 0.22);
    }

    .brand .icon-badge svg {
        width: 25px;
        height: 25px;
    }

    .nav-list {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .nav-item {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 13px 15px;
        border-radius: 10px;
        color: var(--text-soft);
        text-decoration: none;
        font-size: 1.03rem;
        font-weight: 600;
    }

    .nav-item svg {
        width: 23px;
        height: 23px;
        flex-shrink: 0;
        color: var(--text-muted);
    }

    .nav-item:hover {
        background: var(--surface-raised);
        color: var(--text);
    }

    .nav-item:hover svg {
        color: var(--text-soft);
    }

    .nav-item.active {
        background: #e7ecfe;
        color: var(--accent-deep);
        font-weight: 700;
    }

    .nav-item.active svg {
        color: var(--accent-deep);
    }

    /* Main column */
    .main {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
    }

    .topbar {
        height: 76px;
        flex-shrink: 0;
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 32px;
        gap: 24px;
    }

    .search-box {
        flex: 1;
        max-width: 800px;
        display: flex;
        align-items: center;
        gap: 13px;
        background: var(--surface-raised);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 12px 18px;
        color: var(--text-muted);
        font-size: 1rem;
    }

    .search-box svg {
        width: 21px;
        height: 21px;
        flex-shrink: 0;
    }

    .search-box span.kbd {
        margin-left: auto;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-muted);
        background: var(--surface);
        border: 1px solid var(--border-strong);
        border-radius: 6px;
        padding: 2px 7px;
    }

    .topbar-right {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-shrink: 0;
    }

    .icon-btn {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 46px;
        height: 46px;
        border-radius: 10px;
        color: var(--text-soft);
        text-decoration: none;
    }

    .icon-btn:hover {
        background: var(--surface-raised);
    }

    .icon-btn svg {
        width: 24px;
        height: 24px;
    }

    .icon-btn .dot {
        position: absolute;
        top: 8px;
        right: 9px;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--danger);
        border: 2px solid var(--surface);
    }

    .user-menu {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: var(--text);
        padding: 5px 10px 5px 5px;
        border-radius: 26px;
    }

    .user-menu:hover {
        background: var(--surface-raised);
    }

    .avatar {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: linear-gradient(140deg, var(--accent) 0%, var(--accent-deep) 100%);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.98rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        flex-shrink: 0;
    }

    .user-menu span.name {
        font-size: 1.06rem;
        font-weight: 700;
    }

    .user-menu svg {
        width: 18px;
        height: 18px;
        color: var(--text-muted);
    }

    .content {
        padding: 16px 40px 40px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    /* Hero */
    .hero {
        position: relative;
        overflow: hidden;
        /* bleeds through .content's 32px right padding so the artwork runs off the
           page edge instead of stopping at a hard vertical cut */
        margin-right: -40px;
        border-radius: 0;
        background: transparent;
        padding: 18px 76px 90px 0;
        min-height: 240px;
        display: flex;
        align-items: center;
    }

    .hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 32px;
        width: 100%;
    }

    .hero-copy {
        max-width: 720px;
    }

    .hero h1 {
        margin: 0 0 8px;
        font-size: 2.25rem;
        line-height: 1.08;
        letter-spacing: -0.035em;
        font-weight: 800;
        text-align: left;
        color: var(--text);
    }

    .hero p {
        margin: 0;
        color: #2b3c5a;
        font-weight: 500;
        font-size: 1rem;
        line-height: 1.5;
        max-width: 700px;
    }

    .hero .quote {
        flex-shrink: 0;
        margin-left: auto;
        margin-right: 280px;
        margin-top: 8px;
        text-align: left;
        font-family: Georgia, "Iowan Old Style", "Times New Roman", serif;
        font-style: italic;
        font-weight: 400;
        color: #23344f;
        font-size: 1.05rem;
        line-height: 1.5;
        white-space: nowrap;
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.85);
    }

    .hero .quote .attribution {
        display: inline-block;
        margin-top: 4px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        font-style: normal;
        font-weight: 600;
        font-size: 0.82rem;
        letter-spacing: 0.01em;
        color: #44577a;
    }

    .hero .mountains {
        position: absolute;
        right: 0;
        bottom: 0;
        width: 52%;
        height: 100%;
        object-fit: cover;
        object-position: 100% 35%;
        display: block;
        pointer-events: none;
        z-index: 0;
        -webkit-mask-image: linear-gradient(to right, transparent 0%, transparent 5%, rgba(0, 0, 0, 0.3) 22%, rgba(0, 0, 0, 0.68) 42%, #000 62%);
        mask-image: linear-gradient(to right, transparent 0%, transparent 5%, rgba(0, 0, 0, 0.3) 22%, rgba(0, 0, 0, 0.68) 42%, #000 62%);
    }

    /* dissolves the artwork's lower edge into the page so the stat cards sit on it
       without a visible seam showing through the gaps between them */
    .hero::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 80px;
        z-index: 0;
        pointer-events: none;
        background: linear-gradient(to bottom, rgba(249, 250, 251, 0) 0%, rgba(249, 250, 251, 0.72) 45%, var(--bg) 82%);
    }

    /* Stat cards */
    .stat-grid {
        position: relative;
        z-index: 1;
        margin-top: -84px;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }

    .stat-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: var(--card-shadow);
        padding: 16px 18px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .stat-icon svg {
        width: 25px;
        height: 25px;
    }

    .stat-icon.green { background: #dcfce7; color: #15803d; }
    .stat-icon.purple { background: #ede9fe; color: #6d28d9; }
    .stat-icon.orange { background: #fef3c7; color: #b45309; }
    .stat-icon.blue { background: #dbeafe; color: #1d4ed8; }

    .stat-body {
        min-width: 0;
    }

    .stat-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1.25;
    }

    .stat-value {
        display: block;
        margin-top: 1px;
        font-size: 2.05rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.1;
        color: var(--text);
    }

    .stat-sub {
        font-size: 0.85rem;
        color: var(--text-muted);
        display: block;
        margin-top: 1px;
    }

    /* Action row */
    .action-grid {
        display: grid;
        grid-template-columns: 1fr 1.28fr 1.05fr 0.95fr;
        gap: 14px;
    }

    .action-card {
        display: flex;
        align-items: center;
        gap: 14px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: var(--card-shadow);
        padding: 14px 16px;
        text-decoration: none;
        color: var(--text);
    }

    .action-card:hover {
        border-color: var(--border-strong);
    }

    .action-card.primary {
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent-deep) 100%);
        border-color: var(--accent-deep);
        color: #fff;
        box-shadow: 0 2px 4px rgba(27, 63, 209, 0.18), 0 8px 18px rgba(27, 63, 209, 0.22);
    }

    .action-card.primary:hover {
        background: linear-gradient(135deg, var(--accent-hover) 0%, #17369f 100%);
        border-color: #17369f;
    }

    .action-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: rgba(43, 82, 224, 0.1);
        color: var(--accent);
    }

    .action-card.primary .action-icon {
        background: rgba(255, 255, 255, 0.2);
        color: #fff;
    }

    .action-icon svg {
        width: 22px;
        height: 22px;
    }

    .action-text {
        flex: 1;
        min-width: 0;
    }

    .action-text .title {
        display: block;
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.3;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .action-text .subtitle {
        display: block;
        font-size: 0.85rem;
        color: var(--text-muted);
        line-height: 1.3;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .action-card.primary .action-text .subtitle {
        color: rgba(255, 255, 255, 0.82);
    }

    .action-card .chevron {
        width: 18px;
        height: 18px;
        color: var(--text-faint);
        flex-shrink: 0;
    }

    .action-card.primary .chevron {
        color: rgba(255, 255, 255, 0.85);
    }

    /* Panels row */
    .panel-grid {
        margin-top: 6px;
        display: grid;
        grid-template-columns: 0.92fr 1.03fr 1.15fr;
        gap: 16px;
        align-items: stretch;
    }

    .panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: var(--card-shadow);
        padding: 16px 18px;
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 5px;
    }

    .panel-header h2 {
        font-size: 1.08rem;
        font-weight: 700;
        letter-spacing: -0.015em;
        margin: 0;
        color: var(--text);
    }

    .panel-header a {
        font-size: 0.88rem;
        color: var(--accent);
        text-decoration: none;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .panel-header a:hover {
        color: var(--accent-hover);
    }

    .panel-header a svg {
        width: 14px;
        height: 14px;
    }

    .list-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 9px 0;
        border-top: 1px solid var(--border);
    }

    .panel-header + .list-item {
        border-top: none;
    }

    .list-item:last-of-type {
        padding-bottom: 2px;
    }

    .list-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .list-icon svg {
        width: 20px;
        height: 20px;
    }

    .list-icon.blue { background: #dbeafe; color: #1d4ed8; }
    .list-icon.green { background: #dcfce7; color: #15803d; }
    .list-icon.purple { background: #ede9fe; color: #6d28d9; }
    .list-icon.orange { background: #fef3c7; color: #b45309; }

    .list-body {
        flex: 1;
        min-width: 0;
    }

    .list-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1.3;
    }

    .list-subtitle {
        font-size: 0.85rem;
        color: var(--text-muted);
        line-height: 1.35;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .list-meta {
        font-size: 0.8rem;
        color: var(--text-faint);
        line-height: 1.3;
    }

    .list-more {
        color: var(--text-faint);
        flex-shrink: 0;
        width: 22px;
        height: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .list-more:hover {
        color: var(--text-soft);
    }

    .list-more svg {
        width: 17px;
        height: 17px;
    }

    .activity-text {
        font-size: 0.92rem;
        line-height: 1.35;
        color: var(--text-soft);
    }

    .activity-text strong {
        font-weight: 700;
        color: var(--text);
    }

    /* shared chrome for the three dashboard lists */
    .panel-list {
        padding: 18px 20px 20px;
    }

    .panel-list .panel-header {
        padding-bottom: 12px;
        margin-bottom: 10px;
        border-bottom: 1px solid var(--border);
    }

    .panel-list .list-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
    }

    .panel-list .list-icon svg {
        width: 22px;
        height: 22px;
    }

    .panel-list .list-subtitle {
        margin-top: 3px;
    }

    /* only skill groups present their rows as individually selectable cards */
    .panel-groups .panel-header {
        margin-bottom: 14px;
    }

    .panel-groups .list-item {
        border: 1px solid #e9edf4;
        border-radius: 9px;
        padding: 8px 14px;
        gap: 14px;
        margin-bottom: 8px;
    }

    .panel-groups .list-item:last-of-type {
        margin-bottom: 0;
        padding-bottom: 8px;
    }

    .panel-groups .list-item:hover {
        border-color: var(--border-strong);
        background: #fbfcfe;
    }

    .panel-groups .list-icon {
        width: 46px;
        height: 46px;
        border-radius: 11px;
        box-shadow: 0 1px 3px rgba(15, 27, 51, 0.1);
    }

    .panel-groups .list-icon svg {
        width: 23px;
        height: 23px;
    }

    .panel-groups .list-icon.blue { background: #2563eb; color: #fff; }
    .panel-groups .list-icon.green { background: #16a34a; color: #fff; }
    .panel-groups .list-icon.purple { background: #7c3aed; color: #fff; }
    .panel-groups .list-icon.orange { background: #f97316; color: #fff; }

    /* Integrations */
    .integrations-panel {
        padding: 18px 20px 20px;
    }

    .integrations-panel .panel-header {
        padding-bottom: 12px;
        margin-bottom: 14px;
        border-bottom: 1px solid var(--border);
    }

    .integrations-row {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .integration-card {
        border: 1px solid var(--border);
        border-radius: 9px;
        padding: 13px 16px;
        display: flex;
        gap: 14px;
        align-items: center;
        background: var(--surface);
    }

    .integration-card:hover {
        border-color: var(--border-strong);
    }

    .integration-logo {
        width: 50px;
        height: 50px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .integration-logo svg {
        width: 37px;
        height: 37px;
    }

    .integration-body {
        min-width: 0;
    }

    .integration-body .name {
        font-size: 1.08rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1.25;
    }

    .status-row {
        display: flex;
        align-items: center;
        gap: 7px;
        margin: 2px 0;
        font-size: 0.88rem;
        font-weight: 700;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .status-dot.connected { background: #16a34a; }
    .status-dot.not-connected { background: #64748b; }

    .status-row.connected { color: #15803d; }
    .status-row.not-connected { color: #475569; }

    .integration-category {
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    @media (max-width: 1400px) {
        .hero .quote {
            margin-right: 150px;
            font-size: 0.95rem;
        }
    }

    @media (max-width: 1150px) {
        .hero .quote { display: none; }
        .hero h1 { font-size: 1.95rem; }
        .hero { min-height: 210px; }
    }
</style>
{% endblock %}

{% block body %}
<div class="app-shell">
    <aside class="sidebar">
        <div class="brand">
            <span class="icon-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 2.8 20.5 7.5 12 12.2 3.5 7.5z" fill="currentColor" stroke="none"/>
                    <path d="M3.5 11.6 12 16.3l8.5-4.7"/>
                    <path d="M3.5 15.4 12 20.1l8.5-4.7"/>
                </svg>
            </span>
            Skill Vault
        </div>

        <nav class="nav-list">
            <a href="{{ path('app_home') }}" class="nav-item active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                Home
            </a>
            <a href="#" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                Skills
            </a>
            <a href="#" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Skill Groups
            </a>
            <a href="#" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2v5"/><path d="M15 2v5"/><path d="M7 7h10v4a5 5 0 0 1-10 0z"/><path d="M12 16v5"/></svg>
                Integrations
            </a>
            <a href="#" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                Activity
