{% extends 'base.html.twig' %}
{% import 'components/_avatar.html.twig' as avatar %}
{% import 'components/_brand_icons.html.twig' as brand %}
{% import 'components/_shell.html.twig' as shell %}
{% import 'components/_topbar.html.twig' as topbar %}

{% block title %}Skill Vault{% endblock %}

{% block stylesheets %}
{% include 'components/_avatar_styles.html.twig' %}
{% include 'components/_shell_styles.html.twig' %}
{% include 'components/_topbar_styles.html.twig' %}
<style>
    .content {
        padding: 0 40px 40px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    /* Hero */
    .hero {
        position: relative;
        overflow: hidden;
        /* bleeds through .content's 32px right padding so the artwork runs off the
           page edge instead of stopping at a hard vertical cut */
        margin-right: -40px;
        border-radius: 0;
        background: transparent;
        padding: 0 76px 90px 0;
        min-height: 240px;
        display: flex;
        align-items: center;
    }

    .hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 32px;
        width: 100%;
    }

    .hero-copy {
        max-width: 720px;
    }

    .hero h1 {
        margin: 0 0 8px;
        font-size: 2.25rem;
        line-height: 1.08;
        letter-spacing: -0.035em;
        font-weight: 800;
        text-align: left;
        color: var(--text);
    }

    .hero p {
        margin: 0;
        color: #2b3c5a;
        font-weight: 500;
        font-size: 1rem;
        line-height: 1.5;
        max-width: 700px;
    }

    .hero .quote {
        flex-shrink: 0;
        margin-left: auto;
        margin-right: 280px;
        margin-top: 8px;
        text-align: left;
        font-family: Georgia, "Iowan Old Style", "Times New Roman", serif;
        font-style: italic;
        font-weight: 400;
        color: #23344f;
        font-size: 1.05rem;
        line-height: 1.5;
        white-space: nowrap;
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.85);
    }

    .hero .quote .attribution {
        display: inline-block;
        margin-top: 4px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        font-style: normal;
        font-weight: 600;
        font-size: 0.82rem;
        letter-spacing: 0.01em;
        color: #44577a;
    }

    .hero .mountains {
        position: absolute;
        right: 0;
        bottom: 0;
        width: 52%;
        height: 100%;
        object-fit: cover;
        object-position: 100% 35%;
        display: block;
        pointer-events: none;
        z-index: 0;
        -webkit-mask-image: linear-gradient(to right, transparent 0%, transparent 5%, rgba(0, 0, 0, 0.3) 22%, rgba(0, 0, 0, 0.68) 42%, #000 62%);
        mask-image: linear-gradient(to right, transparent 0%, transparent 5%, rgba(0, 0, 0, 0.3) 22%, rgba(0, 0, 0, 0.68) 42%, #000 62%);
    }

    /* dissolves the artwork's lower edge into the page so the stat cards sit on it
       without a visible seam showing through the gaps between them */
    .hero::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 80px;
        z-index: 0;
        pointer-events: none;
        background: linear-gradient(to bottom, rgba(249, 250, 251, 0) 0%, rgba(249, 250, 251, 0.72) 45%, var(--bg) 82%);
    }

    /* Stat cards */
    .stat-grid {
        position: relative;
        z-index: 1;
        margin-top: -84px;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }

    .stat-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: var(--card-shadow);
        padding: 16px 18px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .stat-icon svg {
        width: 25px;
        height: 25px;
    }

    .stat-icon.green { background: #dcfce7; color: #15803d; }
    .stat-icon.purple { background: #ede9fe; color: #6d28d9; }
    .stat-icon.orange { background: #fef3c7; color: #b45309; }
    .stat-icon.blue { background: #dbeafe; color: #1d4ed8; }

    .stat-body {
        min-width: 0;
    }

    .stat-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1.25;
    }

    .stat-value {
        display: block;
        margin-top: 1px;
        font-size: 2.05rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.1;
        color: var(--text);
    }

    .stat-sub {
        font-size: 0.85rem;
        color: var(--text-muted);
        display: block;
        margin-top: 1px;
    }

    /* Action row */
    .action-grid {
        display: grid;
        grid-template-columns: 1fr 1.28fr 1.05fr 0.95fr;
        gap: 14px;
    }

    .action-card {
        display: flex;
        align-items: center;
        gap: 14px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: var(--card-shadow);
        padding: 14px 16px;
        text-decoration: none;
        color: var(--text);
    }

    .action-card:hover {
        border-color: var(--border-strong);
    }

    .action-card.disabled {
        cursor: not-allowed;
        opacity: 0.55;
    }

    .action-card.disabled:hover {
        border-color: var(--border);
    }

    .action-card.primary {
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent-deep) 100%);
        border-color: var(--accent-deep);
        color: #fff;
        box-shadow: 0 2px 4px rgba(27, 63, 209, 0.18), 0 8px 18px rgba(27, 63, 209, 0.22);
    }

    .action-card.primary:hover {
        background: linear-gradient(135deg, var(--accent-hover) 0%, #17369f 100%);
        border-color: #17369f;
    }

    .action-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: rgba(43, 82, 224, 0.1);
        color: var(--accent);
    }

    .action-card.primary .action-icon {
        background: rgba(255, 255, 255, 0.2);
        color: #fff;
    }

    .action-icon svg {
        width: 22px;
        height: 22px;
    }

    .action-text {
        flex: 1;
        min-width: 0;
    }

    .action-text .title {
        display: block;
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.3;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .action-text .subtitle {
        display: block;
        font-size: 0.85rem;
        color: var(--text-muted);
        line-height: 1.3;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .action-card.primary .action-text .subtitle {
        color: rgba(255, 255, 255, 0.82);
    }

    .action-card .chevron {
        width: 18px;
        height: 18px;
        color: var(--text-faint);
        flex-shrink: 0;
    }

    .action-card.primary .chevron {
        color: rgba(255, 255, 255, 0.85);
    }

    /* Panels row */
    .panel-grid {
        margin-top: 6px;
        display: grid;
        grid-template-columns: 0.92fr 1.03fr 1.15fr;
        gap: 16px;
        align-items: stretch;
    }

    .panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: var(--card-shadow);
        padding: 16px 18px;
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 5px;
    }

    .panel-header h2 {
        font-size: 1.08rem;
        font-weight: 700;
        letter-spacing: -0.015em;
        margin: 0;
        color: var(--text);
    }

    .panel-header a {
        font-size: 0.88rem;
        color: var(--accent);
        text-decoration: none;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .panel-header a:hover {
        color: var(--accent-hover);
    }

    .panel-header a svg {
        width: 14px;
        height: 14px;
    }

    .list-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 9px 0;
        border-top: 1px solid var(--border);
    }

    .panel-header + .list-item {
        border-top: none;
    }

    .list-item:last-of-type {
        padding-bottom: 2px;
    }

    .list-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .list-icon svg {
        width: 20px;
        height: 20px;
    }

    .list-icon.blue { background: #dbeafe; color: #1d4ed8; }
    .list-icon.green { background: #dcfce7; color: #15803d; }
    .list-icon.purple { background: #ede9fe; color: #6d28d9; }
    .list-icon.orange { background: #fef3c7; color: #b45309; }

    .list-body {
        flex: 1;
        min-width: 0;
    }

    .list-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1.3;
    }

    .list-subtitle {
        font-size: 0.85rem;
        color: var(--text-muted);
        line-height: 1.35;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .list-meta {
        font-size: 0.8rem;
        color: var(--text-faint);
        line-height: 1.3;
    }

    .list-more {
        color: var(--text-faint);
        flex-shrink: 0;
        width: 22px;
        height: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .list-more:hover {
        color: var(--text-soft);
    }

    .list-more svg {
        width: 17px;
        height: 17px;
    }

    .activity-text {
        font-size: 0.92rem;
        line-height: 1.35;
        color: var(--text-soft);
    }

    .activity-text strong {
        font-weight: 700;
        color: var(--text);
    }

    .panel-empty {
        padding: 32px 12px 24px;
        text-align: center;
    }

    .panel-empty-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 4px;
    }

    .panel-empty-text {
        font-size: 0.85rem;
        color: var(--text-muted);
        line-height: 1.4;
    }

    /* shared chrome for the three dashboard lists */
    .panel-list {
        padding: 18px 20px 20px;
    }

    .panel-list .panel-header {
        padding-bottom: 12px;
        margin-bottom: 10px;
        border-bottom: 1px solid var(--border);
    }

    .panel-list .list-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
    }

    .panel-list .list-icon svg {
        width: 22px;
        height: 22px;
    }

    .panel-list .list-subtitle {
        margin-top: 3px;
    }

    /* only skill groups present their rows as individually selectable cards */
    .panel-groups .panel-header {
        margin-bottom: 14px;
    }

    .panel-groups .list-item {
        border: 1px solid #e9edf4;
        border-radius: 9px;
        padding: 8px 14px;
        gap: 14px;
        margin-bottom: 8px;
    }

    .panel-groups .list-item:last-of-type {
        margin-bottom: 0;
        padding-bottom: 8px;
    }

    .panel-groups .list-item:hover {
        border-color: var(--border-strong);
        background: #fbfcfe;
    }

    /* Integrations */
    .integrations-panel {
        padding: 18px 20px 20px;
    }

    .integrations-panel .panel-header {
        padding-bottom: 12px;
        margin-bottom: 14px;
        border-bottom: 1px solid var(--border);
    }

    .integrations-row {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .integration-card {
        border: 1px solid var(--border);
        border-radius: 9px;
        padding: 13px 16px;
        display: flex;
        gap: 14px;
        align-items: center;
        background: var(--surface);
    }

    .integration-card:hover {
        border-color: var(--border-strong);
    }

    .integration-logo {
        width: 50px;
        height: 50px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .integration-logo svg {
        width: 37px;
        height: 37px;
    }

    .integration-body {
        min-width: 0;
    }

    .integration-body .name {
        font-size: 1.08rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1.25;
    }

    .status-row {
        display: flex;
        align-items: center;
        gap: 7px;
        margin: 2px 0;
        font-size: 0.88rem;
        font-weight: 700;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .status-dot.connected { background: #16a34a; }
    .status-dot.not-connected { background: #64748b; }

    .status-row.connected { color: #15803d; }
    .status-row.not-connected { color: #475569; }

    .integration-category {
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    @media (max-width: 1400px) {
        .hero .quote {
            margin-right: 150px;
            font-size: 0.95rem;
        }
    }

    @media (max-width: 1150px) {
        .hero .quote { display: none; }
        .hero h1 { font-size: 1.95rem; }
        .hero { min-height: 210px; }
    }
</style>
{% endblock %}

{% block body %}
<div class="app-shell">
    {{ shell.sidebar('home') }}

    <div class="main">
        {{ topbar.render(user) }}

        <main class="content">
            <section class="hero">
                <img class="mountains" src="{{ asset('images/nature.jpg') }}" alt="">

                <div class="hero-inner">
                    <div class="hero-copy">
                        <h1>Welcome back, {{ user.firstName }}</h1>
                        <p>Manage your AI skills, organize them into groups, and connect the tools you use.</p>
                    </div>

                    <div class="quote">
                        &ldquo;Small skills.<br>Bigger possibilities.&rdquo;<br>
                        <span class="attribution">&mdash; Skill Vault</span>
                    </div>
                </div>
            </section>

            <section class="stat-grid">
                <div class="stat-card">
                    <span class="stat-icon green">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                    </span>
                    <div class="stat-body">
                        <span class="stat-title">Enabled Skills</span>
                        <span class="stat-value">{{ totalSkills }}</span>
                        <span class="stat-sub">out of {{ totalSkills }} total</span>
                    </div>
                </div>

                <div class="stat-card">
                    <span class="stat-icon purple">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </span>
                    <div class="stat-body">
                        <span class="stat-title">Skill Groups</span>
                        <span class="stat-value">{{ totalGroups }}</span>
                        <span class="stat-sub">Keep organizing</span>
                    </div>
                </div>

                <div class="stat-card">
                    <span class="stat-icon orange">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    </span>
                    <div class="stat-body">
                        <span class="stat-title">Pending Approvals</span>
                        <span class="stat-value">0</span>
                        <span class="stat-sub">No approval workflow yet</span>
                    </div>
                </div>

                <div class="stat-card">
                    <span class="stat-icon blue">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2v5"/><path d="M15 2v5"/><path d="M7 7h10v4a5 5 0 0 1-10 0z"/><path d="M12 16v5"/></svg>
                    </span>
                    <div class="stat-body">
                        <span class="stat-title">Connected Integrations</span>
                        <span class="stat-value">0</span>
                        <span class="stat-sub">out of 2 total</span>
                    </div>
                </div>
            </section>

            <section class="action-grid">
                <a href="{{ path('app_skills_new') }}" class="action-card primary">
                    <span class="action-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    </span>
                    <span class="action-text">
                        <span class="title">Create Skill</span>
                        <span class="subtitle">Build a new AI skill</span>
                    </span>
                    <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </a>

                <a href="{{ path('app_integrations') }}" class="action-card">
                    <span class="action-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2v5"/><path d="M15 2v5"/><path d="M7 7h10v4a5 5 0 0 1-10 0z"/><path d="M12 16v5"/></svg>
                    </span>
                    <span class="action-text">
                        <span class="title">Connect Integrations</span>
                        <span class="subtitle">Link your tools (Trello, Drive, etc.)</span>
                    </span>
                    <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </a>

                <a href="{{ path('app_docs') }}" class="action-card">
                    <span class="action-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                    </span>
                    <span class="action-text">
                        <span class="title">View Documentation</span>
                        <span class="subtitle">Guides and examples</span>
                    </span>
                    <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </a>

                <span class="action-card disabled" aria-disabled="true">
                    <span class="action-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
                    </span>
                    <span class="action-text">
                        <span class="title">Browse Skills</span>
                        <span class="subtitle">Explore templates</span>
                    </span>
                    <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </span>
            </section>

            <section class="panel-grid">
                <div class="panel panel-list panel-groups">
                    <div class="panel-header">
                        <h2>My Skill Groups</h2>
                        <a href="{{ path('app_skill_groups') }}">View all
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                        </a>
                    </div>

                    {% for group in topGroups %}
                        <div class="list-item">
                            {{ avatar.render(group.icon, group.color, 'md') }}
                            <div class="list-body">
                                <div class="list-title">{{ group.name }}</div>
                                <div class="list-subtitle">{{ group.skillCount }} skill{{ group.skillCount == 1 ? '' : 's' }}</div>
                            </div>
                            <span class="list-more">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
                            </span>
                        </div>
                    {% else %}
                        <div class="panel-empty">
                            <p class="panel-empty-text">No skill groups available, please add new ones.</p>
                        </div>
                    {% endfor %}
                </div>

                <div class="panel panel-list">
                    <div class="panel-header">
                        <h2>Recent Skills</h2>
                        <a href="{{ path('app_skills') }}">View all
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                        </a>
                    </div>

                    <div class="panel-empty">
                        <p class="panel-empty-title">Coming soon</p>
                        <p class="panel-empty-text">Recently updated skills will show up here.</p>
                    </div>
                </div>

                <div class="panel panel-list">
                    <div class="panel-header">
                        <h2>Recent Activity</h2>
                        <a href="{{ path('app_activity') }}">View all
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                        </a>
                    </div>

                    <div class="panel-empty">
                        <p class="panel-empty-title">Coming soon</p>
                        <p class="panel-empty-text">A log of who changed what will show up here.</p>
                    </div>
                </div>
            </section>

            <section class="panel integrations-panel">
                <div class="panel-header">
